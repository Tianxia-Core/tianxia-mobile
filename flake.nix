# ffp: FFP-TIANXIA-MOBILE-FLAKE declarative nix
{
  description = "Tianxia Mobile v2.1.0 — Tier-2 Sovereign Android ARM64 Enclave & AetherMesh Bridge";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-25.05";
    tianxia-core = {
      url = "github:Tianxia-Core/TianxiaOS";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, tianxia-core, ... }:
    let
      supportedSystems = [ "x86_64-linux" "aarch64-linux" ];
      forAllSystems = nixpkgs.lib.genAttrs supportedSystems;
    in {
      devShells = forAllSystems (system:
        let pkgs = import nixpkgs { inherit system; };
        in {
          default = pkgs.mkShell {
            buildInputs = with pkgs; [ rustc cargo go jdk17 ];
          };
        }
      );
    };
}
